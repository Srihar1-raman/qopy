{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qopy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "qopy.combif1am.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these immutable social videos need byte ranges. Other assets stay static.
    "run_worker_first": ["/social/qopy-demo-v1.mp4", "/social/qopy-share-v2.mp4"],
    // Navigation uses hash anchors, not client-side routes. Unknown paths stay 404.
    "not_found_handling": "none"
  }
}
